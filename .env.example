PORT=3000
# Email delivery (required for the contact form). Create an API key at
# https://resend.com/api-keys and verify the domain used in CONTACT_FROM_EMAIL.
RESEND_API_KEY=re_your_resend_api_key
CONTACT_TO_EMAIL=amankumarsingh841408@gmail.com
CONTACT_FROM_EMAIL=Portfolio Contact <amankumarsingh841408@gmail.com>

# Optional MySQL connection settings. If omitted, messages are stored locally
# in data/contact-messages.json (which is ignored by Git).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=portfolio_user
DB_PASSWORD=replace_with_a_strong_password
DB_NAME=portfolio_db